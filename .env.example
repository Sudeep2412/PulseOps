# ==============================================================================
# PulseOps Environment Configuration Template
# Copy this file to .env and populate with deployment-specific values.
# NEVER commit actual secrets, keys, or .env files to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=PulseOps
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=true

# Security & Secrets
SECRET_KEY=replace-with-a-secure-random-32-byte-string
ALLOWED_HOSTS=localhost,127.0.0.1

# AWS Configuration (IAM instance roles used by default; static keys prohibited)
AWS_DEFAULT_REGION=us-east-1

# Database Configuration (Planned)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulseops_db
DB_USER=pulseops_user
DB_PASSWORD=replace-with-secure-password

# Observability Configuration (Planned)
PROMETHEUS_METRICS_PORT=9090
GRAFANA_PORT=3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
