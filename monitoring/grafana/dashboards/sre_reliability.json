    },
    {
      "id": 6,
      "title": "Error Budget Burn Rate (1x = Budget Depletes in Window)",
      "description": "Multiples of allowable error consumption rate. 14.4x consumes 2% of monthly budget in 1 hour.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pulseops:error_budget_burn_rate:5m",
          "legendFormat": "5m Burn Rate",
          "refId": "A"
        },
        {
          "expr": "pulseops:error_budget_burn_rate:1h",
          "legendFormat": "1h Burn Rate",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3.0
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "HTTP Error Rate (%) vs Error Budget Consumed",
      "description": "Ratio of 5xx server responses relative to total HTTP requests.",
