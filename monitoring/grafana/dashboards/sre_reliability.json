              },
              {
                "color": "yellow",
                "value": 90.0
              },
              {
                "color": "green",
                "value": 95.0
              }
            ]
          },
          "noValue": "NO TRAFFIC"
        }
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
