    },
    {
      "id": 8,
      "title": "Request Latency Percentiles (P50, P95, P99)",
      "description": "Tail latency percentiles showing performance compliance against the 500ms SLO threshold.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pulseops:sli_p95_latency:seconds_5m",
          "legendFormat": "P95 Latency",
          "refId": "A"
        },
        {
          "expr": "pulseops:sli_p99_latency:seconds_5m",
          "legendFormat": "P99 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(pulseops_http_request_duration_seconds_bucket[5m])) by (le)) or vector(0)",
          "legendFormat": "P50 Latency (Median)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        }
      }
    },
    {
