          "expr": "pulseops:sli_error_rate:ratio_rate5m * 100",
          "legendFormat": "Error Rate % (5m)",
          "refId": "A"
        },
        {
          "expr": "pulseops:error_budget_consumed:percent_5m",
          "legendFormat": "Budget Consumed %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
