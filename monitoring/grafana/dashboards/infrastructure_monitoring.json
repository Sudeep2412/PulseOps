  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Host CPU Utilization by Mode",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (mode) (rate(node_cpu_seconds_total[2m])) * 100",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 2,
      "title": "Host Memory Breakdown (Total, Used, Available)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "Total RAM",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "Used RAM",
          "refId": "B"
        },
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Available RAM",
          "refId": "C"
        },
        {
          "expr": "node_memory_Cached_bytes",
          "legendFormat": "Cached",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "bytes"
        }
      }
    },
    {
      "id": 3,
      "title": "Disk I/O Operations Per Second (IOPS)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(node_disk_reads_completed_total{device=~\"(nvme.*|xvd.*|sd.*)\"}[2m])",
          "legendFormat": "{{device}} - Reads",
          "refId": "A"
        },
        {
          "expr": "rate(node_disk_writes_completed_total{device=~\"(nvme.*|xvd.*|sd.*)\"}[2m])",
          "legendFormat": "{{device}} - Writes",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "iops"
        }
      }
    },
    {
      "id": 4,
      "title": "Disk Read / Write Throughput",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{device=~\"(nvme.*|xvd.*|sd.*)\"}[2m])",
          "legendFormat": "{{device}} - Read Bps",
          "refId": "A"
        },
        {
          "expr": "rate(node_disk_written_bytes_total{device=~\"(nvme.*|xvd.*|sd.*)\"}[2m])",
          "legendFormat": "{{device}} - Write Bps",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "Bps"
        }
      }
    },
    {
      "id": 5,
      "title": "Host Network Traffic (RX / TX)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!~\"(lo|docker.*|veth.*|br.*)\"}[2m])",
          "legendFormat": "{{device}} - Received",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device!~\"(lo|docker.*|veth.*|br.*)\"}[2m])",
          "legendFormat": "{{device}} - Transmitted",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "Bps"
        }
      }
    },
    {
      "id": 6,
      "title": "Linux System Load Average",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "node_load1",
          "legendFormat": "1m Load",
          "refId": "A"
        },
        {
          "expr": "node_load5",
          "legendFormat": "5m Load",
          "refId": "B"
        },
        {
          "expr": "node_load15",
          "legendFormat": "15m Load",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 7,
      "title": "Container Resource Consumption (cAdvisor)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"pulseops.*\"}[2m])) * 100",
          "legendFormat": "{{name}} CPU %",
          "refId": "A"
        },
        {
          "expr": "container_memory_working_set_bytes{name=~\"pulseops.*\"}",
          "legendFormat": "{{name}} RAM",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "short"
        }
      }
    }
  ],
